# Tulip Track — Supabase configuration
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Copy your project URL and anon key below (Settings → API)
#
# When both values are blank, Tulip Track runs in local demo mode.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=